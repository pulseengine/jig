#!/bin/sh
# rivet: verifies REQ-029
# Runs a meld-fused jig under kiln with wasmtime's calling shape, so
# wasm-native.sh compares kiln against native jig unchanged:
#   kiln-run run --dir=. <fused.wasm> args...
# $KILN is the kiln binary, $KILN_IMPORT_MAP the meld --emit-import-map JSON.
# Any fault here (dropped args, no output, wrong exit) differs from native and
# turns the comparison red; wasm-native-differs proves the comparison can.
# kiln 0.9.0 hangs on some x86_64 Linux runners (kiln#748); one call takes
# about 6 s on macOS, so a call still running after $KILN_TIMEOUT seconds
# (default 120) is stopped and named as a hang.
[ "$1" = run ] && [ "$2" = --dir=. ] || { echo "kiln-run: expected 'run --dir=. <wasm> ...'" >&2; exit 2; }
shift 2
wasm=$1
shift
t=${KILN_TIMEOUT:-120}
timeout "$t" "$KILN" --wasi --wasi-fs . --import-map "$KILN_IMPORT_MAP" "$wasm" "$@"
rc=$?
if [ "$rc" = 124 ]; then
  echo "kiln hung (kiln#748): no result after $t s" >&2
fi
exit "$rc"
